{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animegng",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api", "/", "/anime/*", "/watch/*", "/browse/*", "/genre/*", "/season/*", "/schedule", "/search", "/robots.txt", "/llms.txt", "/sitemap*"]
  }
}
