{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animegng",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api", "/", "/anime/*", "/watch/*", "/browse/*", "/genre/*", "/season/*", "/schedule", "/search", "/manga", "/manga/*", "/robots.txt", "/llms.txt", "/.well-known/*", "/sitemap*"]
  },
  // Accounts, history, playlists, subscriptions, comments, votes (migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "animegng", "database_id": "66d59bd9-93e1-4338-bda9-ced3b07ad222", "migrations_dir": "migrations" }
  ],
  // One Durable Object per watch-party room (WebSockets, hibernation API).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PartyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  // Hourly: notify subscribers about newly aired episodes.
  "triggers": { "crons": ["7 * * * *"] },
  // Email goes through Resend (worker/social/extras.js): set the RESEND_API_KEY secret.
  "observability": { "enabled": true }
}
